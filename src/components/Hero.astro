---
// src/components/Hero.astro
// Sección Hero limpia, directa y con texto esencial (sin sobrecarga visual)
---

<section class="py-24 sm:py-32 text-center relative overflow-hidden bg-white">
  <!-- Cuadrícula sutil de fondo -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#f4f4f5_1px,transparent_1px),linear-gradient(to_bottom,#f4f4f5_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Etiqueta superior corta -->
    <span class="inline-block text-xs font-semibold tracking-widest uppercase text-zinc-400 mb-4">
      <span class="lang-zh">西班牙华人基督教会 · 格拉纳达</span>
      <span class="lang-es">ICCE Granada · Iglesia Cristiana China</span>
    </span>

    <!-- Título principal directo -->
    <h1 class="text-5xl sm:text-6xl font-extrabold text-zinc-950 tracking-tight mb-5">
      <span class="lang-zh">欢迎回家</span>
      <span class="lang-es">Bienvenidos a casa</span>
    </h1>

    <!-- Una sola frase clara y acogedora -->
    <p class="text-lg sm:text-xl text-zinc-500 max-w-xl mx-auto mb-8 font-normal leading-relaxed">
      <span class="lang-zh">在格拉纳达的属灵家庭，与你一同在爱与真理中成长。</span>
      <span class="lang-es">Una comunidad de fe, familia y esperanza para todos en Granada.</span>
    </p>

    <!-- Botones de acción directos -->
    <div class="flex items-center justify-center gap-3">
      <a
        id="conocenos"
        href="#horarios"
        class="px-6 py-3 rounded-lg bg-zinc-950 text-white text-sm font-medium hover:bg-zinc-800 transition-colors shadow-xs"
      >
        <span class="lang-zh">认识我们</span>
        <span class="lang-es">Conócenos</span>
      </a>

      <a
        href="#horarios"
        class="px-6 py-3 rounded-lg border border-zinc-200 text-zinc-900 text-sm font-medium hover:bg-zinc-50 transition-colors shadow-xs"
      >
        <span class="lang-zh">聚会时间</span>
        <span class="lang-es">Horarios</span>
      </a>
    </div>
  </div>
</section>

---
// src/components/Schedule.astro
// Sección Horarios de Servicio con la información oficial de la iglesia
import TarjetaHorario from './TarjetaHorario.astro';

const listaHorarios = [
  {
    diaZh: "每周日下午",
    diaEs: "Cada Domingo por la tarde",
    hora: "17:30 – 19:00",
    tituloZh: "主日崇拜",
    tituloEs: "Culto Dominical",
    etiquetaZh: "C/ Rivadavia, 5, Granada · 欢迎参与",
    etiquetaEs: "C/ Rivadavia, 5, Granada · Entrada libre",
    destacado: true
  }
];
---

<section id="horarios" class="py-20 bg-zinc-50 border-b border-zinc-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado simple -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 tracking-tight">
        <span class="lang-zh">聚会时间</span>
        <span class="lang-es">Horarios de Servicio</span>
      </h2>
      <p class="mt-2 text-zinc-500 text-sm">
        <span class="lang-zh">欢迎来到我们当中，一同敬拜与交流。</span>
        <span class="lang-es">Te invitamos a reunirte con nosotros. ¡Te esperamos!</span>
      </p>
    </div>

    <!-- Tarjeta de Horario Oficial Centrada -->
    <div class="max-w-md mx-auto">
      {listaHorarios.map((item) => (
        <TarjetaHorario {...item} />
      ))}
    </div>
  </div>
</section>

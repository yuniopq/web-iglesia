---
// src/components/TarjetaHorario.astro
// Tarjeta de horario limpia, minimalista y directa mediante Props
interface Props {
  dia?: string;
  hora: string;
  titulo?: string;
  etiqueta?: string;
  destacado?: boolean;

  // Propiedades bilingües
  diaZh?: string;
  diaEs?: string;
  tituloZh?: string;
  tituloEs?: string;
  etiquetaZh?: string;
  etiquetaEs?: string;
}

const {
  dia = "",
  hora,
  titulo = "",
  etiqueta = "",
  destacado = false,
  diaZh = dia,
  diaEs = dia,
  tituloZh = titulo,
  tituloEs = titulo,
  etiquetaZh = etiqueta,
  etiquetaEs = etiqueta,
} = Astro.props;
---

<div 
  class:list={[
    "rounded-xl p-6 bg-white flex flex-col justify-between transition-all h-full",
    destacado 
      ? "border-2 border-zinc-950 shadow-sm" 
      : "border border-zinc-200 hover:border-zinc-300"
  ]}
>
  <div>
    <!-- Día -->
    <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider block mb-1">
      <span class="lang-zh">{diaZh}</span>
      <span class="lang-es">{diaEs}</span>
    </span>

    <!-- Nombre del servicio -->
    <h3 class="text-lg font-bold text-zinc-950 mb-3">
      <span class="lang-zh">{tituloZh}</span>
      <span class="lang-es">{tituloEs}</span>
    </h3>

    <!-- Hora destacada -->
    <p class="text-3xl font-extrabold text-zinc-950 font-mono tracking-tight mb-4">
      {hora}
    </p>
  </div>

  <!-- Etiqueta breve al pie -->
  {(etiquetaZh || etiquetaEs) && (
    <div class="pt-3 border-t border-zinc-100 text-xs text-zinc-500 flex items-center gap-2">
      <span class:list={["w-1.5 h-1.5 rounded-full", destacado ? "bg-zinc-950" : "bg-zinc-300"]}></span>
      <span class="lang-zh">{etiquetaZh}</span>
      <span class="lang-es">{etiquetaEs}</span>
    </div>
  )}
</div>

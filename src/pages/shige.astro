    const btnStageViewChords = document.getElementById('btn-stage-view-chords');
    const btnStageViewJianpu = document.getElementById('btn-stage-view-jianpu');

    // Contenido de Escenario
    const stageContentChords = document.getElementById('stage-content-chords');
    const stageContentJianpu = document.getElementById('stage-content-jianpu');
    const stageSongTitle = document.getElementById('stage-song-title');
    const stageSongSubtitle = document.getElementById('stage-song-subtitle');
    const stageLyricsBody = document.getElementById('stage-lyrics-body');
    const stageJianpuImg = document.getElementById('stage-jianpu-img');
    const stageJianpuNone = document.getElementById('stage-jianpu-none');

    // Navegación de Escenario
    const btnStagePrev = document.getElementById('btn-stage-prev');
    const btnStageNext = document.getElementById('btn-stage-next');
    const btnEnterStageSingle = document.getElementById('btn-enter-stage-single');

    // Sincronización del LED con el pulso del metrónomo
    metronome.onTick = (beatIndex, isFirst) => {
      if (!stageMetronomeLed) return;
      if (beatIndex === -1) {
        stageMetronomeLed.className = isStageDarkMode
          ? "w-3 h-3 rounded-full bg-zinc-700 transition-all shadow-xs"
          : "w-3 h-3 rounded-full bg-zinc-300 transition-all shadow-xs";
        return;
      }

      if (isFirst) {
        stageMetronomeLed.className = "w-3 h-3 rounded-full bg-emerald-400 scale-125 shadow-md shadow-emerald-500/60 transition-all duration-75";
      } else {
        stageMetronomeLed.className = "w-3 h-3 rounded-full bg-blue-400 scale-110 shadow-sm shadow-blue-500/60 transition-all duration-75";
      }

      setTimeout(() => {
        if (metronome.isPlaying) {
          stageMetronomeLed.className = isStageDarkMode
            ? "w-3 h-3 rounded-full bg-zinc-700 transition-all duration-100"
            : "w-3 h-3 rounded-full bg-zinc-300 transition-all duration-100";
        }
      }, 90);
    };

    // Botón Play / Pausa del Metrónomo
    btnStageMetronomeToggle?.addEventListener('click', () => {
      if (metronome.isPlaying) {
        metronome.stop();
        btnStageMetronomeToggle.innerHTML = '▶ 节拍';
        btnStageMetronomeToggle.className = isStageDarkMode
          ? "px-2 py-0.5 rounded bg-zinc-800 text-white font-bold text-xs hover:bg-zinc-700 transition-colors"
          : "px-2 py-0.5 rounded bg-zinc-950 text-white font-bold text-xs hover:bg-zinc-800 transition-colors";
      } else {
        metronome.start();
        btnStageMetronomeToggle.innerHTML = '⏸ 停止';
        btnStageMetronomeToggle.className = "px-2 py-0.5 rounded bg-red-600 text-white font-bold text-xs hover:bg-red-700 transition-colors";
      }
    });

    // Tap Tempo
    btnStageMetronomeTap?.addEventListener('click', () => {
      metronome.tap();
      if (stageBpmDisplay) stageBpmDisplay.textContent = metronome.bpm;
      btnStageMetronomeTap.classList.add('bg-zinc-300');
      setTimeout(() => btnStageMetronomeTap.classList.remove('bg-zinc-300'), 120);
    });

    // Control BPM +/-
    btnBpmInc?.addEventListener('click', () => {
      metronome.setBpm(metronome.bpm + 1);
      if (stageBpmDisplay) stageBpmDisplay.textContent = metronome.bpm;
    });

    btnBpmDec?.addEventListener('click', () => {
      metronome.setBpm(metronome.bpm - 1);
      if (stageBpmDisplay) stageBpmDisplay.textContent = metronome.bpm;
    });

    // Sonido Metrónomo On / Off
    btnStageMetronomeSound?.addEventListener('click', () => {
      metronome.soundEnabled = !metronome.soundEnabled;
      btnStageMetronomeSound.textContent = metronome.soundEnabled ? '🔊' : '🔇';
      btnStageMetronomeSound.title = metronome.soundEnabled ? '声音已开启' : '已静音 (仅视觉闪烁)';
    });

    // Abrir Modo Escenario
    function openStageMode(setlistOrSong, initialIndex = 0) {
      if (setlistOrSong.songs) {
        activeSetlist = setlistOrSong;
      } else {
        activeSetlist = {
          id: `temp-${setlistOrSong.id}`,
          titulo: `单曲演练：《${setlistOrSong.titulo}》`,
          songs: [{ songId: setlistOrSong.id, bpm: 120 }]
        };
      }

      currentStageIndex = initialIndex;
      stageCurrentTranspose = 0;
      stageView = 'chords';

      stageContentChords?.classList.remove('hidden');
      stageContentJianpu?.classList.add('hidden');

      stageModeView?.classList.remove('hidden');
      stageModeView?.classList.add('flex');
      document.body.style.overflow = 'hidden';

      applyStageTheme();
    }

    // Salir del Modo Escenario
    btnExitStage?.addEventListener('click', () => {
      metronome.stop();
      if (btnStageMetronomeToggle) {
        btnStageMetronomeToggle.innerHTML = '▶ 节拍';
        btnStageMetronomeToggle.className = isStageDarkMode
          ? "px-2 py-0.5 rounded bg-zinc-800 text-white font-bold text-xs hover:bg-zinc-700 transition-colors"
          : "px-2 py-0.5 rounded bg-zinc-950 text-white font-bold text-xs hover:bg-zinc-800 transition-colors";
      }
      stageModeView?.classList.add('hidden');
      stageModeView?.classList.remove('flex');
      document.body.style.overflow = '';
    });

    // Desde Modal Detalle -> Entrar a Escenario con la canción activa
    btnEnterStageSingle?.addEventListener('click', () => {
      if (!activeSong) return;
      modalDetail.classList.add('hidden');
      document.body.style.overflow = '';
      openStageMode(activeSong, 0);
    });

    // Renderizar la Canción Activa en el Gran Escenario
    function renderStageSong() {
      if (!activeSetlist || !activeSetlist.songs || activeSetlist.songs.length === 0) return;
      if (currentStageIndex < 0) currentStageIndex = 0;
      if (currentStageIndex >= activeSetlist.songs.length) currentStageIndex = activeSetlist.songs.length - 1;

      const currentItem = activeSetlist.songs[currentStageIndex];
      const allAvailableSongs = currentSongs.length > 0 ? currentSongs : sampleSongs;
      const song = allAvailableSongs.find(s => s.id === currentItem.songId) || {
        id: currentItem.songId,
        titulo: "未知诗歌",
        letra: "",
        tono: ""
      };

      // Ajustar métrica del metrónomo (3/4 vs 4/4)
      if (song.tono && /3\/4|3拍/i.test(song.tono)) {
        metronome.beatsPerBar = 3;
      } else if (song.tono && /6\/8|6拍/i.test(song.tono)) {
        metronome.beatsPerBar = 6;
      } else {
        metronome.beatsPerBar = 4;
      }

      // Sincronizar BPM objetivo
      let songBpm = currentItem.bpm;
      if (!songBpm) {
        const bpmMatch = (song.tono || '').match(/(\d{2,3})\s*(?:bpm|拍)/i);
        songBpm = bpmMatch ? parseInt(bpmMatch[1]) : 120;
      }
      metronome.setBpm(songBpm);
      if (stageBpmDisplay) stageBpmDisplay.textContent = metronome.bpm;

      // Encabezado
      if (stageSetlistTitle) stageSetlistTitle.textContent = activeSetlist.titulo;
      if (stageSongCounter) stageSongCounter.textContent = `第 ${currentStageIndex + 1} / ${activeSetlist.songs.length} 首`;

      // Píldoras de navegación rápida entre canciones
      if (stageSongPills) {
        stageSongPills.innerHTML = activeSetlist.songs.map((item, idx) => {
          const s = allAvailableSongs.find(x => x.id === item.songId) || { titulo: `歌曲 ${idx + 1}` };
          const isActive = idx === currentStageIndex;
          const pillClass = isActive
            ? (isStageDarkMode ? 'bg-amber-400 text-zinc-950 font-bold' : 'bg-zinc-950 text-white font-bold')
            : (isStageDarkMode ? 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700' : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-200');
          return `<button type="button" data-stage-idx="${idx}" class="whitespace-nowrap px-3 py-1.5 rounded-lg text-xs transition-colors shadow-2xs flex items-center gap-1 ${pillClass}">
            <span class="opacity-70">${idx + 1}.</span>
            <span class="truncate max-w-[120px] sm:max-w-[180px]">${escapeHtml(s.titulo)}</span>
          </button>`;
        }).join('');

        stageSongPills.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-stage-idx'));
            if (!isNaN(idx) && idx !== currentStageIndex) {
              currentStageIndex = idx;
              stageCurrentTranspose = 0;
              renderStageSong();
            }
          });
        });
      }

      // Título y Tonalidad en Escenario
      if (stageSongTitle) stageSongTitle.textContent = song.titulo;

      let noteName = null;
      if (song.tono) {
        const match = song.tono.match(/(?:1\s*=\s*)?([A-G][#b]?)/i);
        if (match) noteName = match[1].toUpperCase();
      }

      let toneText = song.tono || '原调';
      if (stageCurrentTranspose !== 0) {
        const sign = stageCurrentTranspose > 0 ? `+${stageCurrentTranspose}` : `${stageCurrentTranspose}`;
        const transposedKey = noteName ? transposeNote(noteName, stageCurrentTranspose) : '';
        toneText = transposedKey ? `${toneText} [变调 ${sign} -> 1=${transposedKey}]` : `${toneText} [变调 ${sign}]`;
        if (stageToneDisplay) stageToneDisplay.textContent = transposedKey ? `1=${transposedKey}` : sign;
      } else {
        if (stageToneDisplay) stageToneDisplay.textContent = noteName ? `1=${noteName}` : '原调';
      }

      if (stageSongSubtitle) {
        stageSongSubtitle.textContent = `${song.categoria || '诗歌'} · 调号: ${toneText} · 节拍: ${metronome.beatsPerBar}/4 · 速度: ${metronome.bpm} BPM`;
      }

      // Renderizar Letra Gigante con Acordes
      if (stageLyricsBody) {
        stageLyricsBody.style.fontSize = `${stageFontSize}px`;
        stageLyricsBody.innerHTML = generateLyricsHtml(song.letra || '', stageCurrentTranspose, true, isStageDarkMode);
      }

      // 简谱 Tab
      if (stageJianpuImg && stageJianpuNone) {
        if (song.jianpuUrl) {
          stageJianpuImg.src = song.jianpuUrl;
          stageJianpuImg.classList.remove('hidden');
          stageJianpuNone.classList.add('hidden');
        } else {
          stageJianpuImg.src = '';
          stageJianpuImg.classList.add('hidden');
          stageJianpuNone.classList.remove('hidden');
        }
      }

      // Botones Anterior / Siguiente
      if (btnStagePrev) {
        btnStagePrev.disabled = (currentStageIndex === 0);
        btnStagePrev.classList.toggle('opacity-30', currentStageIndex === 0);
        btnStagePrev.classList.toggle('cursor-not-allowed', currentStageIndex === 0);
      }
      if (btnStageNext) {
        btnStageNext.disabled = (currentStageIndex === activeSetlist.songs.length - 1);
        btnStageNext.classList.toggle('opacity-30', currentStageIndex === activeSetlist.songs.length - 1);
        btnStageNext.classList.toggle('cursor-not-allowed', currentStageIndex === activeSetlist.songs.length - 1);
      }
    }

    // Botones Siguiente / Anterior de Escenario
    btnStagePrev?.addEventListener('click', () => {
      if (currentStageIndex > 0) {
        currentStageIndex--;
        stageCurrentTranspose = 0;
        renderStageSong();
      }
    });

    btnStageNext?.addEventListener('click', () => {
      if (activeSetlist && currentStageIndex < activeSetlist.songs.length - 1) {
        currentStageIndex++;
        stageCurrentTranspose = 0;
        renderStageSong();
      }
    });

    // Controles de Transposición en Escenario
    btnStageTransUp?.addEventListener('click', () => {
      stageCurrentTranspose++;
      if (stageCurrentTranspose > 11) stageCurrentTranspose = 0;
      renderStageSong();
    });

    btnStageTransDown?.addEventListener('click', () => {
      stageCurrentTranspose--;
      if (stageCurrentTranspose < -11) stageCurrentTranspose = 0;
      renderStageSong();
    });

    // Control de Tamaño de Letra en Escenario
    btnStageFontInc?.addEventListener('click', () => {
      if (stageFontSize < 48) {
        stageFontSize += 3;
        if (stageLyricsBody) stageLyricsBody.style.fontSize = `${stageFontSize}px`;
      }
    });

    btnStageFontDec?.addEventListener('click', () => {
      if (stageFontSize > 16) {
        stageFontSize -= 3;
        if (stageLyricsBody) stageLyricsBody.style.fontSize = `${stageFontSize}px`;
      }
    });

    // Alternar Vista: Acordes vs 简谱 en Escenario
    btnStageViewChords?.addEventListener('click', () => {
      stageView = 'chords';
      stageContentChords?.classList.remove('hidden');
      stageContentJianpu?.classList.add('hidden');
      btnStageViewChords.className = isStageDarkMode
        ? "px-2 py-0.5 rounded font-bold bg-zinc-800 text-white shadow-2xs"
        : "px-2 py-0.5 rounded font-bold bg-white text-zinc-950 shadow-2xs";
      btnStageViewJianpu.className = "px-2 py-0.5 rounded font-medium text-zinc-400 hover:text-zinc-200";
    });

    btnStageViewJianpu?.addEventListener('click', () => {
      stageView = 'jianpu';
      stageContentChords?.classList.add('hidden');
      stageContentJianpu?.classList.remove('hidden');
      btnStageViewJianpu.className = isStageDarkMode
        ? "px-2 py-0.5 rounded font-bold bg-zinc-800 text-white shadow-2xs"
        : "px-2 py-0.5 rounded font-bold bg-white text-zinc-950 shadow-2xs";
      btnStageViewChords.className = "px-2 py-0.5 rounded font-medium text-zinc-400 hover:text-zinc-200";
    });

    // Tema Oscuro / Claro en Escenario
    function applyStageTheme() {
      if (isStageDarkMode) {
        stageModeView.className = "fixed inset-0 z-50 bg-zinc-950 text-zinc-100 overflow-y-auto flex flex-col select-none transition-colors duration-200";
        stageHeader.className = "sticky top-0 z-30 bg-zinc-900/95 backdrop-blur-md border-b border-zinc-800 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 shadow-md transition-colors text-zinc-200";
        stageFooter.className = "border-t border-zinc-800 px-6 py-3 bg-zinc-900/90 flex items-center justify-between text-xs text-zinc-400 font-medium transition-colors";
        btnStageThemeToggle.textContent = '☀️';
        btnStageThemeToggle.title = '切换浅色舞台模式';
      } else {
        stageModeView.className = "fixed inset-0 z-50 bg-white text-zinc-950 overflow-y-auto flex flex-col select-none transition-colors duration-200";
        stageHeader.className = "sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-zinc-200 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 shadow-xs transition-colors text-zinc-900";
        stageFooter.className = "border-t border-zinc-200/80 px-6 py-3 bg-zinc-50/80 flex items-center justify-between text-xs text-zinc-500 font-medium transition-colors";
        btnStageThemeToggle.textContent = '🌙';
        btnStageThemeToggle.title = '切换深色舞台模式';
      }
      renderStageSong();
    }

    btnStageThemeToggle?.addEventListener('click', () => {
      isStageDarkMode = !isStageDarkMode;
      applyStageTheme();
    });

    // Atajos de Teclado para el Escenario
    document.addEventListener('keydown', (e) => {
      if (stageModeView && !stageModeView.classList.contains('hidden')) {
        if (e.code === 'Space') {
          e.preventDefault();
          btnStageMetronomeToggle?.click();
        } else if (e.code === 'ArrowRight' || e.code === 'KeyN') {
          e.preventDefault();
          btnStageNext?.click();
        } else if (e.code === 'ArrowLeft' || e.code === 'KeyP') {
          e.preventDefault();
          btnStagePrev?.click();
        } else if (e.code === 'Escape') {
          e.preventDefault();
          btnExitStage?.click();
        }
      }
    });

    // Iniciar carga al cargar el DOM
    document.addEventListener('DOMContentLoaded', () => {
      loadSongs();
      loadSetlists();
    });
  </script>
</Layout>

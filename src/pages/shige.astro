    });

    // Cargar Setlists desde Firestore (con fallback local)
    function loadSetlists() {
      try {
        const setlistCol = collection(db, 'setlists');
        const q = query(setlistCol, orderBy('fecha', 'desc'));

        onSnapshot(q, (snapshot) => {
          if (!snapshot.empty) {
            currentSetlists = snapshot.docs.map(doc => ({
              id: doc.id,
              ...doc.data()
            }));
          } else {
            currentSetlists = [...sampleSetlists];
          }
          renderSetlists();
        }, (err) => {
          console.warn("Firestore setlists fallback a muestra inicial:", err);
          currentSetlists = [...sampleSetlists];
          renderSetlists();
        });
      } catch (err) {
        console.warn("Error conectando a Firestore setlists:", err);
        currentSetlists = [...sampleSetlists];
        renderSetlists();
      }
    }

    // Renderizar tarjetas de Setlist
    function renderSetlists() {
      if (setlistBadgeCount) {
        setlistBadgeCount.textContent = currentSetlists.length;
      }

      if (!setlistsGrid || !setlistsEmpty) return;

      if (currentSetlists.length === 0) {
        setlistsGrid.classList.add('hidden');
        setlistsEmpty.classList.remove('hidden');
        return;
      }

      setlistsEmpty.classList.add('hidden');
      setlistsGrid.classList.remove('hidden');
      setlistsGrid.innerHTML = '';

      const allAvailableSongs = currentSongs.length > 0 ? currentSongs : sampleSongs;

      currentSetlists.forEach(setlist => {
        const card = document.createElement('div');
        card.className = "rounded-2xl p-6 bg-white border border-zinc-200 hover:border-zinc-950 hover:shadow-lg transition-all flex flex-col justify-between";

        const songItemsHtml = (setlist.songs || []).map((item, idx) => {
          const s = allAvailableSongs.find(x => x.id === item.songId) || { titulo: "未知诗歌", tono: "" };
          return `
            <li class="flex items-center justify-between py-2 border-b border-zinc-100 last:border-0 text-xs">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-zinc-100 text-zinc-600 font-mono font-bold flex items-center justify-center text-[10px]">${idx + 1}</span>
                <span class="font-bold text-zinc-900">${escapeHtml(s.titulo)}</span>
                ${s.tono ? `<span class="text-zinc-400 font-mono text-[10.5px]">(${escapeHtml(s.tono)})</span>` : ''}
              </div>
              <span class="font-mono text-zinc-500 font-medium text-[11px] bg-zinc-50 px-2 py-0.5 rounded border border-zinc-200/60">
                ${item.bpm || 120} BPM
              </span>
            </li>
          `;
        }).join('');

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-zinc-900 text-white">
                📅 ${escapeHtml(setlist.fecha || '主日敬拜')}
              </span>
              <span class="text-xs text-zinc-500 font-medium">
                共 ${setlist.songs?.length || 0} 首诗歌
              </span>
            </div>

            <h3 class="font-extrabold text-lg text-zinc-950 mb-1">
              ${escapeHtml(setlist.titulo)}
            </h3>

            ${setlist.notas ? `<p class="text-xs text-zinc-500 mb-4">${escapeHtml(setlist.notas)}</p>` : '<div class="mb-4"></div>'}

            <div class="bg-zinc-50 rounded-xl p-3 border border-zinc-200/70 mb-5">
              <ul class="space-y-0.5">
                ${songItemsHtml || '<li class="text-zinc-400 text-center py-2 text-xs">暂无选入诗歌</li>'}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-zinc-100 flex items-center justify-between gap-2">
            <button type="button" data-action="stage" class="flex-grow py-2.5 px-4 rounded-xl bg-zinc-950 text-white font-bold text-xs hover:bg-zinc-800 transition-colors shadow-xs flex items-center justify-center gap-2">
              <span>🎙️</span>
              <span>进入大屏演练 (Modo Culto)</span>
            </button>
            <button type="button" data-action="edit" class="p-2.5 rounded-xl border border-zinc-200 text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition-colors" title="修改歌单">
              ✏️
            </button>
            <button type="button" data-action="delete" class="p-2.5 rounded-xl border border-zinc-200 text-red-500 hover:text-red-700 hover:bg-red-50 transition-colors" title="删除歌单">
              🗑️
            </button>
          </div>
        `;

        card.querySelector('[data-action="stage"]')?.addEventListener('click', () => {
          openStageMode(setlist, 0);
        });

        card.querySelector('[data-action="edit"]')?.addEventListener('click', () => {
          openSetlistFormModal(setlist);
        });

        card.querySelector('[data-action="delete"]')?.addEventListener('click', async () => {
          const confirmDelete = confirm(`确定要删除敬拜歌单《${setlist.titulo}》吗？`);
          if (!confirmDelete) return;

          try {
            if (setlist.id.startsWith('seed-')) {
              currentSetlists = currentSetlists.filter(s => s.id !== setlist.id);
              renderSetlists();
            } else {
              await deleteDoc(doc(db, 'setlists', setlist.id));
            }
          } catch (err) {
            console.error("Error al eliminar setlist:", err);
            alert("删除失败，请检查 Firestore 规则权限。");
          }
        });

        setlistsGrid.appendChild(card);
      });
    }

    // Modal Crear / Editar Setlist
    function openSetlistFormModal(setlistToEdit = null) {
      setlistErrorMsg?.classList.add('hidden');

      if (setlistToEdit) {
        document.getElementById('modal-setlist-title').textContent = `编辑敬拜歌单：《${setlistToEdit.titulo}》`;
        inputSetlistId.value = setlistToEdit.id;
        inputSetlistName.value = setlistToEdit.titulo || '';
        inputSetlistDate.value = setlistToEdit.fecha || '';
        inputSetlistNotes.value = setlistToEdit.notas || '';
      } else {
        document.getElementById('modal-setlist-title').textContent = '新建敬拜歌单';
        inputSetlistId.value = '';
        const today = new Date().toISOString().split('T')[0];
        inputSetlistDate.value = today;
        inputSetlistName.value = `${today} 主日敬拜`;
        inputSetlistNotes.value = '主领: 敬拜团';
      }

      setlistSongsPicker.innerHTML = '';
      const selectedMap = new Map();
      if (setlistToEdit && setlistToEdit.songs) {
        setlistToEdit.songs.forEach(item => selectedMap.set(item.songId, item.bpm || 120));
      }

      const allAvailableSongs = currentSongs.length > 0 ? currentSongs : sampleSongs;

      allAvailableSongs.forEach(song => {
        const isChecked = selectedMap.has(song.id);
        const existingBpm = selectedMap.get(song.id) || 120;

        const row = document.createElement('div');
        row.className = "p-3 flex items-center justify-between gap-3 hover:bg-zinc-100/60 transition-colors";
        row.innerHTML = `
          <label class="flex items-center gap-2.5 cursor-pointer flex-grow select-none">
            <input type="checkbox" data-song-id="${song.id}" class="setlist-song-check rounded border-zinc-300 text-zinc-950 focus:ring-0 w-4 h-4 cursor-pointer" ${isChecked ? 'checked' : ''} />
            <div>
              <span class="font-bold text-zinc-900 text-xs">${escapeHtml(song.titulo)}</span>
              <span class="text-[10.5px] text-zinc-400 block">${song.categoria || '诗歌'} · ${song.tono || '调号未定'}</span>
            </div>
          </label>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[10px] text-zinc-400">BPM</span>
            <input type="number" min="40" max="250" value="${existingBpm}" data-bpm-for="${song.id}" class="w-16 px-2 py-1 rounded border border-zinc-200 text-xs font-mono text-center bg-white" />
          </div>
        `;
        setlistSongsPicker.appendChild(row);
      });

      const updateSelectedCount = () => {
        const checks = setlistSongsPicker.querySelectorAll('.setlist-song-check:checked');
        if (setlistSelectedCount) setlistSelectedCount.textContent = checks.length;
      };
      setlistSongsPicker.addEventListener('change', updateSelectedCount);
      updateSelectedCount();

      modalSetlistForm?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    const closeSetlistModal = () => {
      modalSetlistForm?.classList.add('hidden');
      document.body.style.overflow = '';
      formSetlist.reset();
      setlistErrorMsg?.classList.add('hidden');
    };

    btnOpenCreateSetlist?.addEventListener('click', () => openSetlistFormModal(null));
    btnCloseSetlistForm?.addEventListener('click', closeSetlistModal);
    btnCancelSetlistForm?.addEventListener('click', closeSetlistModal);

    // Guardar Setlist en Firestore
    formSetlist?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const checkedBoxes = setlistSongsPicker.querySelectorAll('.setlist-song-check:checked');
      if (checkedBoxes.length === 0) {
        setlistErrorMsg.textContent = '请至少勾选 1 首诗歌加入敬拜歌单。';
        setlistErrorMsg.classList.remove('hidden');
        return;
      }

      const selectedSongs = [];
      checkedBoxes.forEach(box => {
        const songId = box.getAttribute('data-song-id');
        const bpmInput = setlistSongsPicker.querySelector(`input[data-bpm-for="${songId}"]`);
        const bpm = bpmInput ? parseInt(bpmInput.value) || 120 : 120;
        selectedSongs.push({ songId, bpm });
      });

      const editId = inputSetlistId.value;
      const setlistData = {
        titulo: inputSetlistName.value.trim(),
        fecha: inputSetlistDate.value,
        notas: inputSetlistNotes.value.trim(),
        songs: selectedSongs
      };

      btnSubmitSetlist.disabled = true;
      btnSubmitSetlist.textContent = '正在保存...';

      try {
        if (!editId) {
          await addDoc(collection(db, 'setlists'), {
            ...setlistData,
            createdAt: serverTimestamp()
          });
        } else if (editId.startsWith('seed-')) {
          await addDoc(collection(db, 'setlists'), {
            ...setlistData,
            createdAt: serverTimestamp()
          });
          currentSetlists = currentSetlists.filter(s => s.id !== editId);
        } else {
          const docRef = doc(db, 'setlists', editId);
          await updateDoc(docRef, {
            ...setlistData,
            updatedAt: serverTimestamp()
          });
        }

        closeSetlistModal();
      } catch (err) {
        console.error("Error al guardar setlist:", err);
        setlistErrorMsg.textContent = `保存失败 (${err.code || '权限受限'})：请检查 Firestore 规则。`;
        setlistErrorMsg.classList.remove('hidden');
      } finally {
        btnSubmitSetlist.disabled = false;
        btnSubmitSetlist.textContent = '保存敬拜歌单';
      }
    });

    // =============================================================

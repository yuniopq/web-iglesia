      parsedBatchSongs = parseAnySongInput(text);

      if (parsedBatchSongs.length > 0) {
        batchPreviewBox?.classList.remove('hidden');
        batchCountBadge.textContent = `✓ 成功识别 ${parsedBatchSongs.length} 首诗歌`;
        batchPreviewList.innerHTML = parsedBatchSongs.map((s, idx) => `
          <li class="flex items-center justify-between py-1 border-b border-blue-100 last:border-0">
            <span class="font-bold text-zinc-900">${idx + 1}. 《${s.titulo}》</span>

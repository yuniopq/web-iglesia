        batchPreviewBox?.classList.add('hidden');
      }
    });

    // Guardar lote masivo en Firestore
    btnSubmitBatch?.addEventListener('click', async () => {
      if (parsedBatchSongs.length === 0) {
        parsedBatchSongs = parseAnySongInput(inputBatchJson.value.trim());
      }

      if (parsedBatchSongs.length === 0) {
        batchErrorMsg.textContent = '未能识别出有效的诗歌数据，请检查 JSON 格式或确保每首诗歌都包含 titulo / 歌名。';
        batchErrorMsg.classList.remove('hidden');
        return;
      }

      btnSubmitBatch.disabled = true;
      btnSubmitBatch.textContent = `正在导入 (0/${parsedBatchSongs.length})...`;
      batchErrorMsg?.classList.add('hidden');

      try {
        const shigeCol = collection(db, 'shige');
        let count = 0;

        for (const song of parsedBatchSongs) {
          const finalJianpu = formatDriveOrImageUrl(song.jianpuUrl || '');
          await addDoc(shigeCol, {
            titulo: song.titulo,
            tono: song.tono || '',
            categoria: song.categoria || '敬拜赞美',
            jianpuUrl: finalJianpu,
            audioUrl: song.audioUrl || '',
            letra: song.letra || '',
            createdAt: serverTimestamp()
          });
          count++;
          btnSubmitBatch.textContent = `正在导入 (${count}/${parsedBatchSongs.length})...`;
        }

        closeBatchModal();
        alert(`🎉 成功批量导入 ${count} 首诗歌到云端诗歌本！`);
      } catch (err) {
        console.error("Error al importar lote en Firestore:", err);
        batchErrorMsg.textContent = `批量导入失败 (${err.code || '权限受限'})：请检查网络或 Firebase Firestore 规则权限。`;
        batchErrorMsg.classList.remove('hidden');

      modalAdd.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    // Eliminar Canción
    btnDeleteSong?.addEventListener('click', async () => {
      if (!activeSong) return;
      const confirmed = confirm(`确定要从诗歌本中删除《${activeSong.titulo}》吗？\n¿Estás seguro de que deseas eliminar esta canción?`);
      if (!confirmed) return;

      btnDeleteSong.disabled = true;
      btnDeleteSong.textContent = '正在删除...';

      try {
        if (activeSong.id.startsWith('seed-')) {
          // Si es una canción local de muestra, la retiramos de la vista
          currentSongs = currentSongs.filter(s => s.id !== activeSong.id);
          renderSongs();
        } else {
          // Si es una canción real de Firestore, la eliminamos de la nube
          await deleteDoc(doc(db, 'shige', activeSong.id));
        }

        modalDetail.classList.add('hidden');
        document.body.style.overflow = '';
        document.getElementById('detail-youtube-iframe').src = '';
      } catch (err) {
        console.error("Error al eliminar la canción:", err);
        alert("删除失败，请检查 Firebase Firestore 规则权限。");
      } finally {
        btnDeleteSong.disabled = false;
        btnDeleteSong.innerHTML = '<span>🗑️</span><span class="lang-zh">删除</span><span class="lang-es">Eliminar</span>';
      }
    });

    const closeAddModal = () => {
      modalAdd.classList.add('hidden');
      document.body.style.overflow = '';
      formAdd.reset();
      setImagePreview(null);
      document.getElementById('add-error-msg').classList.add('hidden');
    };

    btnCloseAdd?.addEventListener('click', closeAddModal);
    btnCancelAdd?.addEventListener('click', closeAddModal);

    // Guardar (Crear o Actualizar) en Firestore
    formAdd?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('btn-submit-song');
      const errorMsg = document.getElementById('add-error-msg');
      const editId = inputEditId.value;
      submitBtn.disabled = true;
      submitBtn.textContent = '正在保存到云端...';
      errorMsg.classList.add('hidden');

      let jianpuFinalUrl = '';
      try {
        if (cachedCompressedDataUrl || selectedImageFile) {
          submitBtn.textContent = '正在保存简谱图片...';
          jianpuFinalUrl = await processImageUpload(selectedImageFile);
        } else if (inputJianpuUrl.value.trim()) {
          jianpuFinalUrl = formatDriveOrImageUrl(inputJianpuUrl.value.trim());
        } else if (editId && activeSong && activeSong.jianpuUrl && !imagePreviewContainer.classList.contains('hidden')) {
          jianpuFinalUrl = activeSong.jianpuUrl;
        }

        const songData = {
          titulo: document.getElementById('input-title').value.trim(),
          tono: document.getElementById('input-tone').value.trim(),
          categoria: document.getElementById('input-category').value,
          jianpuUrl: jianpuFinalUrl,
          audioUrl: document.getElementById('input-audio-url').value.trim(),
          letra: document.getElementById('input-lyrics').value.trim(),
        };

        if (!editId) {
          // 1. Modo creación nuevo
          await addDoc(collection(db, 'shige'), {
            ...songData,
            createdAt: serverTimestamp()
          });
        } else if (editId.startsWith('seed-')) {
          // 2. Si era una canción de muestra que se edita, se guarda como documento nuevo en Firestore
          await addDoc(collection(db, 'shige'), {
            ...songData,
            createdAt: serverTimestamp()
          });
          currentSongs = currentSongs.filter(s => s.id !== editId);
        } else {
          // 3. Modo actualización en Firestore
          const docRef = doc(db, 'shige', editId);
          await updateDoc(docRef, {
            ...songData,
            updatedAt: serverTimestamp()
          });
        }

        closeAddModal();
      } catch (err) {
        console.error("Error al guardar en Firestore:", err);
        errorMsg.textContent = `保存失败 (${err.code || '权限受限'})：请检查网络或 Firebase 控制台 Firestore 规则。`;
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = editId ? '保存修改 (Guardar Cambios)' : '保存到云端诗歌本';
      }
    });


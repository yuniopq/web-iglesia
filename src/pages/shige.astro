    // Escalas cromáticas y mapeo para transposición
    const CHROMATIC_SHARPS = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
    const CHROMATIC_FLATS  = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'];
    const NOTE_INDEX_MAP = {
      'C': 0, 'B#': 0,
      'C#': 1, 'DB': 1,
      'D': 2,
      'D#': 3, 'EB': 3,
      'E': 4, 'FB': 4,
      'F': 5, 'E#': 5,
      'F#': 6, 'GB': 6,
      'G': 7,
      'G#': 8, 'AB': 8,
      'A': 9,
      'A#': 10, 'BB': 10,
      'B': 11, 'CB': 11
    };

    function isChordToken(token) {
      if (!token) return false;
      const t = token.trim();
      return /^[A-Ga-g][#b]?(?:m|maj|min|dim|aug|sus|add|\d|\+|-|\(|\)|b5|#5|b9|#9)*(?:\/[A-Ga-g][#b]?)?$/.test(t);
    }

    function transposeNote(note, shift, preferFlats = false) {
      const upper = note.toUpperCase();
      let idx = NOTE_INDEX_MAP[upper];
      if (idx === undefined) return note;
      let newIdx = (idx + shift) % 12;
      if (newIdx < 0) newIdx += 12;
      return preferFlats ? CHROMATIC_FLATS[newIdx] : CHROMATIC_SHARPS[newIdx];
    }

    function transposeChord(chordStr, shift) {
      if (shift === 0) return chordStr;
      const match = chordStr.match(/^([A-Ga-g][#b]?)([^/]*)(?:\/([A-Ga-g][#b]?))?$/);
      if (!match) return chordStr;
      const [_, root, modifier, bass] = match;
      const preferFlats = root.toLowerCase().includes('b') || (bass && bass.toLowerCase().includes('b'));
      const newRoot = transposeNote(root, shift, preferFlats);
      const newBass = bass ? '/' + transposeNote(bass, shift, preferFlats) : '';
      return `${newRoot}${modifier}${newBass}`;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // -------------------------------------------------------------
    // PARSERS: RECONOCIMIENTO INTELIGENTE DE CANCIONES (JSON O TEXTO)
    // -------------------------------------------------------------
    function normalizeSongObject(obj) {
      if (!obj || typeof obj !== 'object') return null;
      const titulo = (obj.titulo || obj.title || obj.name || obj['歌名'] || obj['标题'] || '').trim();
      if (!titulo) return null;

      return {
        titulo,
        tono: (obj.tono || obj.key || obj.tone || obj['调号'] || '').trim(),
        categoria: (obj.categoria || obj.category || obj['分类'] || '敬拜赞美').trim(),
        jianpuUrl: (obj.jianpuUrl || obj.jianpu || obj.partitura || obj.sheetMusic || obj['简谱'] || '').trim(),
        audioUrl: (obj.audioUrl || obj.audio || obj.youtube || obj.video || obj['试听'] || obj['音频'] || '').trim(),
        letra: (obj.letra || obj.lyrics || obj.chord || obj['歌词'] || '').trim()
      };
    }

    function parsePlainTextSong(text) {
      const lines = text.split('\n');
      const song = {
        titulo: '',
        tono: '',
        categoria: '敬拜赞美',
        jianpuUrl: '',
        audioUrl: '',
        letra: ''
      };

      let inLyrics = false;
      const lyricLines = [];

      for (let line of lines) {
        const trimmed = line.trim();

        if (inLyrics) {
          lyricLines.push(line);
          continue;
        }

        if (trimmed === '---' || /^(?:歌词|lyrics|letra)\s*[:：]?$/i.test(trimmed)) {
          inLyrics = true;
          continue;
        }

        const titleMatch = trimmed.match(/^(?:歌名|标题|title|titulo)\s*[:：]\s*(.+)/i);
        if (titleMatch) { song.titulo = titleMatch[1].trim(); continue; }

        const toneMatch = trimmed.match(/^(?:调号|tonalidad|key|tone)\s*[:：]\s*(.+)/i);
        if (toneMatch) { song.tono = toneMatch[1].trim(); continue; }

        const catMatch = trimmed.match(/^(?:分类|category|categoria)\s*[:：]\s*(.+)/i);
        if (catMatch) { song.categoria = catMatch[1].trim(); continue; }

        const jianpuMatch = trimmed.match(/^(?:简谱|partitura|sheet)\s*[:：]\s*(.+)/i);
        if (jianpuMatch) { song.jianpuUrl = jianpuMatch[1].trim(); continue; }

        const audioMatch = trimmed.match(/^(?:试听|音频|audio|youtube|video)\s*[:：]\s*(.+)/i);
        if (audioMatch) { song.audioUrl = audioMatch[1].trim(); continue; }

        if (trimmed.startsWith('[') || trimmed.startsWith('【')) {
          inLyrics = true;
          lyricLines.push(line);
          continue;
        }
      }

      song.letra = lyricLines.join('\n').trim();
      return song;
    }

    function parseAnySongInput(raw) {
      const trimmed = (raw || '').trim();
      if (!trimmed) return [];

      // 1. Intentar JSON
      if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
        try {
          const parsed = JSON.parse(trimmed);
          if (Array.isArray(parsed)) {
            return parsed.map(normalizeSongObject).filter(Boolean);
          } else if (parsed && typeof parsed === 'object') {
            const song = normalizeSongObject(parsed);
            return song ? [song] : [];
          }
        } catch (e) {
          // Si el JSON falla, pasa a texto plano
        }
      }

      // 2. Intentar formato texto estructurado
      const song = parsePlainTextSong(trimmed);
      return song.titulo ? [song] : [];
    }


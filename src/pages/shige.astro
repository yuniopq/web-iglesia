    // Escalas cromáticas y mapeo para transposición
    const CHROMATIC_SHARPS = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
    const CHROMATIC_FLATS  = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'];
    const NOTE_INDEX_MAP = {
      'C': 0, 'B#': 0,
      'C#': 1, 'DB': 1,
      'D': 2,
      'D#': 3, 'EB': 3,
      'E': 4, 'FB': 4,
      'F': 5, 'E#': 5,
      'F#': 6, 'GB': 6,
      'G': 7,
      'G#': 8, 'AB': 8,
      'A': 9,
      'A#': 10, 'BB': 10,
      'B': 11, 'CB': 11
    };

    function isChordToken(token) {
      if (!token) return false;
      const t = token.trim();
      return /^[A-Ga-g][#b]?(?:m|maj|min|dim|aug|sus|add|\d|\+|-|\(|\)|b5|#5|b9|#9)*(?:\/[A-Ga-g][#b]?)?$/.test(t);
    }

    function transposeNote(note, shift, preferFlats = false) {
      const upper = note.toUpperCase();
      let idx = NOTE_INDEX_MAP[upper];
      if (idx === undefined) return note;
      let newIdx = (idx + shift) % 12;
      if (newIdx < 0) newIdx += 12;
      return preferFlats ? CHROMATIC_FLATS[newIdx] : CHROMATIC_SHARPS[newIdx];
    }

    function transposeChord(chordStr, shift) {
      if (shift === 0) return chordStr;
      const match = chordStr.match(/^([A-Ga-g][#b]?)([^/]*)(?:\/([A-Ga-g][#b]?))?$/);
      if (!match) return chordStr;
      const [_, root, modifier, bass] = match;
      const preferFlats = root.toLowerCase().includes('b') || (bass && bass.toLowerCase().includes('b'));
      const newRoot = transposeNote(root, shift, preferFlats);
      const newBass = bass ? '/' + transposeNote(bass, shift, preferFlats) : '';
      return `${newRoot}${modifier}${newBass}`;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }


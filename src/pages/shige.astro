        onSnapshot(q, (snapshot) => {
          loadingSpinner.classList.add('hidden');
          
          if (!snapshot.empty) {
            seedBanner?.classList.add('hidden');
            currentSongs = snapshot.docs.map(doc => ({
              id: doc.id,
              ...doc.data()
            }));
          } else {
            // Si Firestore está vacío, usamos la lista semilla inicial y mostramos la opción de guardarlas
            seedBanner?.classList.remove('hidden');
            currentSongs = [...sampleSongs];
          }

          renderSongs();
        }, (err) => {
          console.warn("Firestore error o colección aún sin crear, usando lista inicial:", err);
          loadingSpinner.classList.add('hidden');
          seedBanner?.classList.remove('hidden');
          currentSongs = [...sampleSongs];
          renderSongs();
        });
      } catch (err) {
        console.warn("No se pudo conectar a Firestore, usando fallback local:", err);
        loadingSpinner.classList.add('hidden');
        seedBanner?.classList.remove('hidden');
        currentSongs = [...sampleSongs];
        renderSongs();
      }
    }

    // Botón para importar canciones de muestra a Firestore
    btnSeedFirebase?.addEventListener('click', async () => {
      btnSeedFirebase.disabled = true;
      btnSeedFirebase.textContent = '正在保存到云端...';
      try {
        const shigeCol = collection(db, 'shige');
        for (const s of sampleSongs) {
          const { id, ...data } = s;
          await addDoc(shigeCol, {
            ...data,
            createdAt: serverTimestamp()
          });
        }
        seedBanner?.classList.add('hidden');
      } catch (err) {
        console.error("Error al importar canciones a Firestore:", err);
        alert("保存失败，请检查 Firebase Console 中 Firestore 的规则(Rules)是否允许写入。");
        btnSeedFirebase.disabled = false;
        btnSeedFirebase.textContent = '一键保存至 Firebase';
      }
    });

    // 2. Renderizar lista filtrada
    function renderSongs() {
      const filtered = currentSongs.filter(song => {
        const matchesCategory = currentCategory === 'ALL' || song.categoria === currentCategory;
        const q = searchQuery.toLowerCase().trim();
        const matchesSearch = !q || 
          (song.titulo && song.titulo.toLowerCase().includes(q)) ||
          (song.tituloEs && song.tituloEs.toLowerCase().includes(q)) ||
          (song.letra && song.letra.toLowerCase().includes(q)) ||
          (song.tono && song.tono.toLowerCase().includes(q));

        return matchesCategory && matchesSearch;
      });

      songsGrid.innerHTML = '';

      if (filtered.length === 0) {
        songsGrid.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      songsGrid.classList.remove('hidden');

      filtered.forEach(song => {
        const card = document.createElement('div');
        card.className = "rounded-xl p-5 bg-white border border-zinc-200 hover:border-zinc-950 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between group";
        
        // Vista previa de letra limpia (quitando etiquetas de acordes [C] para la tarjeta)
        const cleanForPreview = (song.letra || '').replace(/\[[A-Ga-g][#b]?[^\]]*\]/g, '');
        const firstLines = cleanForPreview.split('\n').filter(l => l.trim() && !l.includes('【')).slice(0, 2).join(' / ');

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-zinc-100 text-zinc-600 border border-zinc-200">
                ${song.categoria || '诗歌'}
              </span>
              ${song.tono ? `<span class="font-mono text-xs font-bold text-zinc-950">${song.tono}</span>` : ''}
            </div>

            <h3 class="font-bold text-base text-zinc-950 group-hover:text-zinc-700 transition-colors">
              ${song.titulo}
            </h3>
            ${song.tituloEs ? `<p class="text-xs text-zinc-400 font-medium mb-3">${song.tituloEs}</p>` : ''}

            <p class="text-xs text-zinc-500 line-clamp-2 my-2 leading-relaxed">
              ${firstLines || '点击查看完整诗歌简谱与歌词...'}
            </p>
          </div>

          <div class="pt-3 border-t border-zinc-100 flex items-center justify-between text-xs text-zinc-400 mt-3">
            <div class="flex items-center gap-2">
              ${song.jianpuUrl ? '<span title="包含简谱">🎼 简谱</span>' : '<span class="text-zinc-300">🎼 简谱</span>'}
              <span title="包含歌词与和弦">🎸 和弦歌词</span>
              ${song.audioUrl ? '<span title="包含音频">🎧 试听</span>' : ''}
            </div>
            <span class="text-zinc-950 font-semibold group-hover:translate-x-0.5 transition-transform">查阅 →</span>
          </div>
        `;

        card.addEventListener('click', () => openDetailModal(song));
        songsGrid.appendChild(card);
      });
    }

    // 3. Renderizar el visor de acordes y letras interactivo
    function updateTransposeStatusUI() {
      if (!transposeStatus) return;
      
      let noteName = null;
      if (activeSong?.tono) {
        const match = activeSong.tono.match(/(?:1\s*=\s*)?([A-G][#b]?)/i);
        if (match) noteName = match[1].toUpperCase();
      }

      if (currentTranspose === 0) {
        transposeStatus.textContent = noteName ? `原调 (${noteName})` : '原调 (0)';
        transposeStatus.className = "px-2.5 py-1 font-mono font-semibold text-zinc-700 min-w-[70px] text-center bg-zinc-50 select-none text-xs";
      } else {
        const sign = currentTranspose > 0 ? `+${currentTranspose}` : `${currentTranspose}`;
        const transposedKey = noteName ? transposeNote(noteName, currentTranspose) : '';
        transposeStatus.textContent = transposedKey ? `${sign} (${transposedKey})` : sign;
        transposeStatus.className = "px-2.5 py-1 font-mono font-bold text-blue-700 min-w-[70px] text-center bg-blue-50/70 select-none text-xs";
      }
    }

    function generateLyricsHtml(text, transpose = 0, withChords = true, isDark = false) {
      if (!text || !text.trim()) {
        return `<p class="${isDark ? 'text-zinc-500' : 'text-zinc-400'} text-center py-8 text-sm">暂无歌词内容</p>`;
      }

      const lines = text.split('\n');
      const htmlLines = [];

      const chordTextColor = isDark ? 'text-amber-400' : 'text-blue-600';
      const chordBoxClass = isDark 
        ? 'text-amber-300 bg-amber-950/60 border-amber-700/80' 
        : 'text-blue-600 bg-blue-50/70 border-blue-200/60';
      const chordRowBoxClass = isDark
        ? 'bg-zinc-900/90 border-zinc-800'
        : 'bg-zinc-100/70 border-zinc-200/80';
      const sectionTitleClass = isDark ? 'text-zinc-400' : 'text-zinc-500';
      const sectionDotClass = isDark ? 'bg-amber-400' : 'bg-zinc-950';
      const lyricTextColor = isDark ? 'text-zinc-100' : 'text-zinc-900';

      for (let rawLine of lines) {
        const line = rawLine.trimEnd();

        // Línea vacía
        if (!line.trim()) {
          htmlLines.push('<div class="h-4"></div>');
          continue;
        }

        // Título de sección (ej. 【副歌】 o [Chorus])
        if (/^(【[^】]+】|\[(副歌|主歌|前奏|间奏|尾奏|桥段|Chorus|Verse|Bridge|Intro|Outro|Tag|\d+)[^\]]*\])$/i.test(line.trim())) {
          htmlLines.push(`
            <div class="font-bold text-xs uppercase tracking-wider ${sectionTitleClass} mt-6 mb-2.5 flex items-center gap-1.5 select-none">
              <span class="w-2 h-2 rounded-full ${sectionDotClass}"></span>
              <span>${escapeHtml(line.trim())}</span>
            </div>
          `);
          continue;
        }

        // Parsear unidades de acorde y letra en formato ChordPro
        const regex = /\[([^\]]+)\]/g;
        let lastIdx = 0;
        let currentChord = null;
        let units = [];
        let match;

        while ((match = regex.exec(line)) !== null) {
          const token = match[1];
          const textBefore = line.substring(lastIdx, match.index);

          if (currentChord !== null || textBefore.length > 0) {
            units.push({
              chord: currentChord,
              text: textBefore
            });
            currentChord = null;
          }

          if (isChordToken(token)) {
            currentChord = transposeChord(token, transpose);
          } else {
            // Etiqueta que no es acorde musical
            units.push({
              chord: null,
              text: `[${token}]`
            });
          }

          lastIdx = regex.lastIndex;
        }

        const textRemaining = line.substring(lastIdx);
        if (currentChord !== null || textRemaining.length > 0) {
          units.push({
            chord: currentChord,
            text: textRemaining
          });
        }

        const hasChordsInLine = units.some(u => u.chord);

        if (!hasChordsInLine || !withChords) {
          // Línea limpia sin acordes
          const cleanLineText = units.map(u => escapeHtml(u.text)).join('');
          htmlLines.push(`<div class="my-1.5 leading-relaxed ${lyricTextColor}">${cleanLineText || '&nbsp;'}</div>`);
        } else {
          // 1. Caso especial: Línea exclusivamente de acordes (instrumental, intro, interludio, solo)
          const isChordOnlyLine = hasChordsInLine && units.every(u => !u.text || /^[|\/\-.\s]*$/.test(u.text));

          if (isChordOnlyLine) {
            const chordRowHtml = units.map(u => {
              const chordHtml = u.chord 
                ? `<span class="chord-tag font-mono font-bold text-[0.88em] ${chordBoxClass} px-2.5 py-0.5 rounded-md border select-all shadow-2xs">${escapeHtml(u.chord)}</span>` 
                : '';
              const sep = u.text ? escapeHtml(u.text) : '';
              const sepHtml = sep.trim() ? `<span class="text-zinc-500 font-mono px-1 select-none">${sep}</span>` : (sep ? `<span class="inline-block w-3"></span>` : '');
              return `${chordHtml}${sepHtml}`;
            }).join('');

            htmlLines.push(`
              <div class="chord-only-line flex flex-wrap items-center gap-2 my-2.5 py-2 px-3 rounded-lg ${chordRowBoxClass} border">
                <span class="text-[10px] font-bold text-zinc-500 select-none mr-1 font-mono tracking-wider">和弦:</span>
                ${chordRowHtml}
              </div>
            `);
            continue;
          }

          // 2. Línea regular con letra y acordes alineados sobre cada sílaba
          const unitsHtml = units.map(u => {
            const chordHtml = u.chord 
              ? `<span class="chord-tag font-mono font-bold text-[0.82em] ${chordTextColor} leading-none mb-1 select-all">${escapeHtml(u.chord)}</span>` 
              : `<span class="chord-tag font-mono text-[0.82em] leading-none mb-1 opacity-0 select-none">&nbsp;</span>`;
            const textHtml = escapeHtml(u.text) || '&nbsp;';
            return `
              <span class="inline-flex flex-col items-start align-bottom mr-1 mb-2">
                ${chordHtml}
                <span class="lyric-syllable leading-normal ${lyricTextColor} whitespace-pre min-h-[1.25em]">${textHtml}</span>
              </span>
            `;
          }).join('');

          htmlLines.push(`<div class="chord-line flex flex-wrap items-end my-1">${unitsHtml}</div>`);
        }
      }

      return htmlLines.join('');
    }

    function renderLyricsSheet() {
      if (!detailLyricsContainer || !activeSong) return;
      detailLyricsContainer.style.fontSize = `${currentFontSize}px`;
      updateTransposeStatusUI();
      detailLyricsContainer.innerHTML = generateLyricsHtml(activeSong.letra || '', currentTranspose, showChords, false);
    }

    // 4. Abrir Modal de Detalle
    function openDetailModal(song) {
      activeSong = song;
      currentTranspose = 0; // Reiniciar transposición al abrir canción

      document.getElementById('detail-title').textContent = song.titulo;
      document.getElementById('detail-category').textContent = song.categoria || '诗歌';
      document.getElementById('detail-tone').textContent = song.tono ? `调号: ${song.tono}` : '调号未定';

      // 简谱 Tab
      const jianpuImg = document.getElementById('detail-jianpu-img');
      const jianpuEmpty = document.getElementById('jianpu-empty');
      const jianpuActions = document.getElementById('jianpu-actions');
      const jianpuLink = document.getElementById('detail-jianpu-link');

      if (song.jianpuUrl) {
        jianpuImg.src = song.jianpuUrl;
        jianpuImg.classList.remove('hidden');
        jianpuEmpty.classList.add('hidden');
        jianpuActions.classList.remove('hidden');
        jianpuLink.href = song.jianpuUrl;
      } else {
        jianpuImg.src = '';
        jianpuImg.classList.add('hidden');
        jianpuEmpty.classList.remove('hidden');
        jianpuActions.classList.add('hidden');
      }

      // Renderizar pestaña de Letra & Acordes
      renderLyricsSheet();

      // Audio Tab
      const audioBox = document.getElementById('audio-player-box');
      const audioEmpty = document.getElementById('audio-empty');
      const iframe = document.getElementById('detail-youtube-iframe');
      const audioPlayer = document.getElementById('detail-audio-player');

      if (song.audioUrl) {
        audioBox.classList.remove('hidden');
        audioEmpty.classList.add('hidden');

        if (song.audioUrl.includes('youtube.com') || song.audioUrl.includes('youtu.be')) {
          let videoId = '';
          if (song.audioUrl.includes('v=')) {
            videoId = song.audioUrl.split('v=')[1]?.split('&')[0];
          } else if (song.audioUrl.includes('youtu.be/')) {
            videoId = song.audioUrl.split('youtu.be/')[1]?.split('?')[0];
          }
          iframe.src = videoId ? `https://www.youtube.com/embed/${videoId}` : song.audioUrl;
          iframe.classList.remove('hidden');
          audioPlayer.classList.add('hidden');
        } else {
          audioPlayer.src = song.audioUrl;
          audioPlayer.classList.remove('hidden');
          iframe.classList.add('hidden');
        }
      } else {
        audioBox.classList.add('hidden');
        audioEmpty.classList.remove('hidden');
        iframe.src = '';
        audioPlayer.src = '';
      }

      // Si tiene 简谱, abrimos en pestaña 简谱 por defecto; si no, en 歌词
      if (song.jianpuUrl) {
        switchTab('jianpu');
      } else {
        switchTab('lyrics');
      }

      modalDetail.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    // 5. Cambiar entre pestañas
    function switchTab(tab) {
      tabBtnJianpu.className = "py-3 px-4 border-b-2 " + (tab === 'jianpu' ? "border-zinc-950 text-zinc-950 font-bold" : "border-transparent text-zinc-500 hover:text-zinc-900") + " flex items-center gap-1.5 transition-all";
      tabBtnLyrics.className = "py-3 px-4 border-b-2 " + (tab === 'lyrics' ? "border-zinc-950 text-zinc-950 font-bold" : "border-transparent text-zinc-500 hover:text-zinc-900") + " flex items-center gap-1.5 transition-all";
      tabBtnAudio.className = "py-3 px-4 border-b-2 " + (tab === 'audio' ? "border-zinc-950 text-zinc-950 font-bold" : "border-transparent text-zinc-500 hover:text-zinc-900") + " flex items-center gap-1.5 transition-all";

      tabContentJianpu.classList.toggle('hidden', tab !== 'jianpu');
      tabContentLyrics.classList.toggle('hidden', tab !== 'lyrics');
      tabContentAudio.classList.toggle('hidden', tab !== 'audio');
    }

    tabBtnJianpu?.addEventListener('click', () => switchTab('jianpu'));
    tabBtnLyrics?.addEventListener('click', () => switchTab('lyrics'));
    tabBtnAudio?.addEventListener('click', () => switchTab('audio'));

    // Cerrar Modal Detalle
    btnCloseDetail?.addEventListener('click', () => {
      modalDetail.classList.add('hidden');
      document.body.style.overflow = '';
      document.getElementById('detail-youtube-iframe').src = '';
    });

    // Control de Transposición (+1, -1, Reset)
    btnTransposeUp?.addEventListener('click', () => {
      currentTranspose = (currentTranspose + 1);
      if (currentTranspose > 11) currentTranspose = 0;
      renderLyricsSheet();
    });

    btnTransposeDown?.addEventListener('click', () => {
      currentTranspose = (currentTranspose - 1);
      if (currentTranspose < -11) currentTranspose = 0;
      renderLyricsSheet();
    });

    btnTransposeReset?.addEventListener('click', () => {
      currentTranspose = 0;
      renderLyricsSheet();
    });

    // Toggle para mostrar/ocultar acordes
    toggleShowChords?.addEventListener('change', (e) => {
      showChords = e.target.checked;
      renderLyricsSheet();
    });

    // Control de tamaño de letra
    btnFontInc?.addEventListener('click', () => {
      if (currentFontSize < 28) {
        currentFontSize += 2;
        renderLyricsSheet();
      }
    });

    btnFontDec?.addEventListener('click', () => {
      if (currentFontSize > 12) {
        currentFontSize -= 2;
        renderLyricsSheet();
      }
    });

    // Copiar letra (con o sin acordes transpuestos según la opción activa)
    btnCopyLyrics?.addEventListener('click', () => {
      if (!activeSong) return;
      let textToCopy = '';
      if (showChords) {
        const lines = (activeSong.letra || '').split('\n').map(line => {
          return line.replace(/\[([^\]]+)\]/g, (m, token) => {
            return isChordToken(token) ? `[${transposeChord(token, currentTranspose)}]` : m;
          });
        }).join('\n');
        textToCopy = `${activeSong.titulo}\n调号: ${activeSong.tono || '未定'}${currentTranspose !== 0 ? ` (变调: ${currentTranspose > 0 ? '+' : ''}${currentTranspose})` : ''}\n\n${lines}`;
      } else {
        const cleanLines = (activeSong.letra || '').split('\n').map(line => {
          return line.replace(/\[([^\]]+)\]/g, (m, token) => {
            return isChordToken(token) ? '' : m;
          });
        }).join('\n');
        textToCopy = `${activeSong.titulo}\n调号: ${activeSong.tono || '未定'}\n\n${cleanLines}`;
      }

      navigator.clipboard.writeText(textToCopy).then(() => {
        btnCopyLyrics.textContent = '✓ 已复制歌词';
        setTimeout(() => {
          btnCopyLyrics.textContent = '📋 复制歌词';
        }, 2000);
      });
    });

    // Copiar JSON de la canción activa
    const btnCopySongJson = document.getElementById('btn-copy-song-json');
    btnCopySongJson?.addEventListener('click', () => {
      if (!activeSong) return;
      const songData = {
        titulo: activeSong.titulo,
        tono: activeSong.tono || '',
        categoria: activeSong.categoria || '敬拜赞美',
        jianpuUrl: activeSong.jianpuUrl || '',
        audioUrl: activeSong.audioUrl || '',
        letra: activeSong.letra || ''
      };
      navigator.clipboard.writeText(JSON.stringify(songData, null, 2)).then(() => {
        btnCopySongJson.textContent = '✓ 已复制 JSON';
        setTimeout(() => {
          btnCopySongJson.textContent = '{ } 复制 JSON';
        }, 2000);
      });
    });

    // Filtros de categoría
    categoryPills?.addEventListener('click', (e) => {
      const target = e.target.closest('button');
      if (!target) return;

      document.querySelectorAll('#category-pills button').forEach(btn => {
        btn.className = "pill-btn px-3 py-1.5 rounded-md font-medium border border-zinc-200 bg-white text-zinc-600 hover:border-zinc-400 transition-all";
      });

      target.className = "pill-btn active px-3 py-1.5 rounded-md font-medium border border-zinc-900 bg-zinc-900 text-white transition-all";
      currentCategory = target.getAttribute('data-category') || 'ALL';
      renderSongs();
    });

    // Buscador
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderSongs();
    });

    // Botones de Editar y Eliminar
    const btnEditSong = document.getElementById('btn-edit-song');
    const btnDeleteSong = document.getElementById('btn-delete-song');
    const inputEditId = document.getElementById('input-edit-id');
    const modalFormTitle = document.getElementById('modal-form-title');

    // Abrir Modal Añadir Canción (Modo nuevo)
    btnOpenAdd?.addEventListener('click', () => {
      inputEditId.value = '';
      modalFormTitle.textContent = '添加新诗歌到云端';
      document.getElementById('btn-submit-song').textContent = '保存到云端诗歌本';
      formAdd.reset();
      setImagePreview(null);
      document.getElementById('add-error-msg').classList.add('hidden');
      modalAdd.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    // Abrir Modal Editar Canción (Modo modificación)
    btnEditSong?.addEventListener('click', () => {
      if (!activeSong) return;
      modalDetail.classList.add('hidden');
      document.getElementById('detail-youtube-iframe').src = '';

      inputEditId.value = activeSong.id;
      modalFormTitle.textContent = `编辑修改诗歌：《${activeSong.titulo}》`;
      document.getElementById('btn-submit-song').textContent = '保存修改 (Guardar Cambios)';

      document.getElementById('input-title').value = activeSong.titulo || '';
      document.getElementById('input-tone').value = activeSong.tono || '';
      document.getElementById('input-category').value = activeSong.categoria || '敬拜赞美';
      
      if (activeSong.jianpuUrl) {
        setImagePreview(activeSong.jianpuUrl, '当前保存的简谱图片');
        inputJianpuUrl.value = activeSong.jianpuUrl.startsWith('data:') ? '' : activeSong.jianpuUrl;
      } else {
